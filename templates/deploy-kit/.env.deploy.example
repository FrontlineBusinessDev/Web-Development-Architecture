# Copy to .env.deploy (git-ignored: never commit it) and fill in. No quotes around values.
# Used by scripts/publish.sh (php artisan deploy) on your PC only. See DEPLOY.md, step 4.

# root@ and the server's IP or name. The user must be able to run docker there.
DEPLOY_SSH=root@<server>
# The Coolify dashboard's address.
COOLIFY_URL=https://<coolify dashboard address>
# The app resource's uuid (last part of its address in Coolify). Used to read its variables.
COOLIFY_UUID=<app resource uuid>
# The deployer resource's uuid. Never the app's: started directly, the app restarts everything at once.
COOLIFY_DEPLOYER_UUID=<deployer resource uuid>
# Coolify > Keys & Tokens > API tokens, with read, read:sensitive and deploy. One per person.
COOLIFY_API_TOKEN=<token>
